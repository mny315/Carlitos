import { ScrollView, ListView, ComboBox, SpinBox } from "std-widgets.slint";
import { State } from "../state.slint";
import { SyncAction } from "../components/sync-action.slint";
import { Theme } from "../components/theme.slint";
import { Action, Label, Toggle, BusyStatus, PercentSlider, Field } from "../components/controls.slint";

component ScaleSetting inherits VerticalLayout {
    in property <string> title;
    in property <string> description;
    in property <int> minimum: 70;
    in property <int> maximum;
    in-out property <int> percent: 100;
    callback committed;
    callback previewed;
    spacing: 8px;
    Label { text: root.title; wrap: word-wrap; }
    HorizontalLayout {
        spacing: 8px; alignment: start;
        SpinBox {
            max-width: 140px;
            minimum: root.minimum; maximum: root.maximum; step-size: 15;
            value <=> root.percent;
            min-height: Theme.action-height;
            accessible-label: root.title + " (%)";
            edited(_) => { root.committed(); }
        }
        Label { text: "%"; horizontal-stretch: 0; }
        Action {
            text: "100%";
            accessible-label: Theme.t("Сбросить: ", "Reset: ") + root.title;
            enabled: root.percent != 100;
            clicked => { root.percent = 100; root.committed(); }
        }
    }
    PercentSlider {
        minimum: root.minimum; maximum: root.maximum;
        value <=> root.percent;
        input-scale: State.android ? State.ui-scale-percent / 100 : 1;
        label: root.title;
        changed => { root.previewed(); }
        released => { root.committed(); }
        dragging-changed(dragging) => { State.display-settings-dragging = dragging; }
    }
    Label { text: root.description; color: Theme.muted; wrap: word-wrap; font-size: 12px * Theme.font-scale; }
}

component ThemeChoice inherits ComboBox {
    max-width: 280px;
    model: State.theme-labels; current-index <=> State.theme-index;
    selected(_) => { State.settings-changed(); }
}

component LanguageChoice inherits ComboBox {
    max-width: 280px;
    model: State.language-labels; current-index <=> State.language-index;
    selected(_) => { State.settings-changed(); }
}

component PairingToggle inherits Action {
    fill: State.android;
    text: Theme.t("Подключение по коду", "Pair using a code");
    selected: State.sync-manual;
    trailing-icon: State.sync-manual ? @image-url("../icons/up.svg") : @image-url("../icons/down.svg");
    clicked => { State.sync-manual = !State.sync-manual; }
}

component QrAction inherits Action {
    fill: State.android;
    primary: State.sync-invitation == "" && !State.android;
    text: State.android ? root.accessible-label : State.sync-invitation == "" ? Theme.t("Показать QR", "Show QR") : Theme.t("Закрыть QR", "Close QR");
    accessible-label: State.sync-invitation == "" ? Theme.t("Показать QR для подключения", "Show pairing QR code") : Theme.t("Закрыть QR-код", "Close QR code");
    clicked => { State.action(State.sync-invitation == "" ? "sync-invite" : "sync-cancel", ""); }
}

component SettingsContent inherits VerticalLayout {
        private property <bool> grouped: !State.android && root.width >= 640px * Theme.font-scale;
        spacing: 18px; padding-right: 12px;
        Label { text: Theme.t("Настройки", "Settings"); font-size: (28px) * Theme.font-scale; font-weight: 650; }
        Label { text: Theme.t("ОФОРМЛЕНИЕ", "APPEARANCE"); color: Theme.muted; font-size: (11px) * Theme.font-scale; }
        if State.android: Action { fill: true; text: State.theme-labels[State.theme-index]; icon: @image-url("../icons/down.svg"); clicked => { State.overlay = 10; } }
        if State.android: Action { fill: true; text: State.language-labels[State.language-index]; icon: @image-url("../icons/down.svg"); clicked => { State.overlay = 11; } }
        if root.grouped: HorizontalLayout {
            spacing: 12px; alignment: start;
            ThemeChoice { }
            LanguageChoice { }
        }
        if !State.android && !root.grouped: VerticalLayout {
            spacing: 10px;
            ThemeChoice { }
            LanguageChoice { }
        }
        ScaleSetting {
            title: Theme.t("Размер текста", "Text size");
            description: "70–205%";
            maximum: 205; percent <=> State.text-size-percent;
            previewed => { State.display-settings-preview(); }
            committed => { State.settings-changed(); }
        }
        if State.android: ScaleSetting {
            title: Theme.t("Масштаб интерфейса", "Interface scale");
            description: "70–160%";
            maximum: 160; percent <=> State.ui-scale-percent;
            previewed => { State.display-settings-preview(); }
            committed => { State.settings-changed(); }
        }
        Label { text: Theme.t("ПОВЕДЕНИЕ", "BEHAVIOR"); color: Theme.muted; font-size: (11px) * Theme.font-scale; }
        if !State.android: Toggle { text: Theme.t("Закрывать в трей", "Close to tray"); description: Theme.t("При наличии трея окно скрывается в него.", "Hides the window in the system tray when available."); checked <=> State.close-to-tray; toggled => { State.settings-changed(); } }
        Toggle { text: Theme.t("Отключить анимации", "Disable animations"); description: Theme.t("Убирает плавные переходы страниц, меню, цветов и плеера.", "Turns off smooth page, menu, color and player transitions."); checked <=> Theme.reduced-motion; toggled => { State.settings-changed(); } }
        Toggle { text: Theme.t("Пропускать тишину", "Skip silence"); description: Theme.t("Сокращает длинные тихие паузы, сохраняя короткие паузы между фразами.", "Shortens long quiet pauses while keeping brief pauses between phrases."); checked <=> State.skip-silence; toggled => { State.action("skip-silence", ""); } }
        if State.android: VerticalLayout {
            spacing: 8px;
            Action { fill: true; text: Theme.t("Фоновая работа", "Background playback"); clicked => { State.action("battery-settings", ""); } }
            Label { text: Theme.t("Отключите оптимизацию батареи для Carlitos, чтобы снизить риск остановки книги при выключенном экране.", "Turn off battery optimization for Carlitos to reduce interruptions while the screen is off."); color: Theme.muted; wrap: word-wrap; font-size: 12px * Theme.font-scale; }
        }
        Label { text: Theme.t("УСТРОЙСТВА", "DEVICES"); color: Theme.muted; font-size: 11px * Theme.font-scale; }
        Toggle {
            text: Theme.t("Синхронизация", "Synchronization");
            description: Theme.t("Позиция и скорость каждой книги в вашей локальной сети.", "Each book's position and speed on your local network.");
            checked <=> State.local-sync;
            toggled => { State.settings-changed(); }
        }
        if State.local-sync: VerticalLayout {
            spacing: 10px;
            Label { text: State.sync-name; color: Theme.muted; wrap: word-wrap; }
            if State.sync-indexing: BusyStatus { text: Theme.t("Подготавливаем книги для синхронизации…", "Preparing books for synchronization…"); }
            Label { text: Theme.t("Подключите устройства к одному роутеру и откройте Carlitos на обоих. На них должны быть одинаковые аудиофайлы книг.", "Connect both devices to the same router and open Carlitos on both. They must have the same audiobook files."); color: Theme.muted; wrap: word-wrap; font-size: 12px * Theme.font-scale; }
            if root.grouped: HorizontalLayout {
                spacing: 8px; alignment: start;
                QrAction { }
                PairingToggle { }
                if State.sync-peers.length > 0: SyncAction { }
            }
            if State.android: Action { fill: true; primary: true; text: Theme.t("Сканировать QR", "Scan QR code"); clicked => { State.action("sync-scan", ""); } }
            if !root.grouped: QrAction { }
            if State.sync-invitation != "": VerticalLayout {
                spacing: 8px;
                HorizontalLayout { alignment: State.android ? center : start;
                    Image { source: State.sync-qr; width: min(320px, parent.width); height: self.width; image-fit: contain; image-rendering: pixelated; accessible-label: Theme.t("QR-код подключения Carlitos", "Carlitos pairing QR code"); }
                }
                Label { text: Theme.t("Отсканируйте в Carlitos на другом устройстве. Код действует 5 минут и только для одного подключения.", "Scan in Carlitos on the other device. The code expires in 5 minutes and pairs one device."); wrap: word-wrap; color: Theme.muted; font-size: 12px * Theme.font-scale; }
            }
            if !root.grouped: PairingToggle { }
            if State.sync-manual: VerticalLayout {
                vertical-stretch: 0;
                max-width: State.android ? 100000px : 520px;
                spacing: 8px;
                if State.sync-invitation != "": VerticalLayout {
                    spacing: 6px;
                    Label { text: Theme.t("Введите этот код на другом устройстве", "Enter this code on the other device"); wrap: word-wrap; color: Theme.muted; font-size: 12px * Theme.font-scale; }
                    Field { text: State.sync-code; text-size: 12px * Theme.font-scale; read-only: true; clip: true; label: Theme.t("Код подключения для копирования", "Pairing code to copy"); }
                }
                if State.sync-invitation == "": Action { fill: State.android; text: Theme.t("Показать мой код", "Show my code"); clicked => { State.action("sync-invite", ""); } }
                HorizontalLayout {
                    spacing: 8px; vertical-stretch: 0;
                    pairing-input := Field {
                        horizontal-stretch: 1; min-width: 0px; clip: true;
                        text <=> State.sync-input;
                        placeholder: Theme.t("Код устройства", "Device code");
                        accepted(_) => { if (State.sync-input != "") { State.action("sync-pair", ""); } }
                    }
                    Action {
                        text: Theme.t("Подключить", "Pair");
                        primary: State.sync-input != "";
                        clicked => { if (State.sync-input != "") { State.action("sync-pair", ""); } else { pairing-input.focus(); } }
                    }
                }
            }
            if State.sync-message != "": Label { text: State.sync-message; wrap: word-wrap; color: State.sync-error ? Theme.danger : Theme.muted; }
            if State.sync-peers.length > 0: Label { text: Theme.t("Связанные устройства", "Paired devices"); color: Theme.muted; font-size: 12px * Theme.font-scale; }
            for peer in State.sync-peers: HorizontalLayout {
                spacing: 12px; max-width: State.android ? 100000px : 520px;
                VerticalLayout { alignment: center; spacing: 4px;
                    Label { text: peer.name; wrap: word-wrap; }
                    Label { text: peer.online ? Theme.t("На связи", "Connected") : Theme.t("Не в сети", "Offline"); color: Theme.muted; font-size: 12px * Theme.font-scale; }
                }
                Action { destructive: true; text: Theme.t("Отвязать", "Unpair"); accessible-label: Theme.t("Отвязать устройство ", "Unpair device ") + peer.name; clicked => { State.action("sync-forget", peer.key); } }
            }
            if State.sync-peers.length > 0 && !root.grouped: SyncAction { fill: State.android; }
            Label { text: Theme.t("Прогресс обновляется автоматически. Для ручного обмена достаточно нажать кнопку на одном устройстве.", "Progress updates automatically. To sync manually, press the button on either device."); color: Theme.muted; wrap: word-wrap; font-size: 12px * Theme.font-scale; }
        }
        Rectangle { min-height: 16px; vertical-stretch: 1; }
}

export component SettingsPage inherits Rectangle {
    if !State.android: desktop-scroll := ScrollView {
        content-width: self.visible-width;
        content-height: max(self.visible-height, desktop-content.preferred-height);
        desktop-content := SettingsContent {
            x: 0px; y: 0px;
            width: min(680px, desktop-scroll.visible-width); height: self.preferred-height;
        }
    }
    if State.android: Rectangle {
        scroll := Flickable {
            width: parent.width; height: parent.height;
            // Scaling changes the logical pointer coordinates. Once a slider
            // owns the gesture, those changes must not start a vertical scroll.
            interactive: !State.display-settings-dragging;
            content-width: self.width;
            content-height: content.preferred-height;
            content := SettingsContent { width: parent.width; }
        }
        Rectangle {
            x: parent.width - 2px; width: 2px;
            height: min(parent.height, max(24px, parent.height * parent.height / max(1px, scroll.content-height)));
            y: clamp(-scroll.content-y / max(1px, scroll.content-height - scroll.height), 0, 1) * (parent.height - self.height);
            visible: scroll.content-height > scroll.height;
            border-radius: 1px; background: Theme.line;
        }
    }
}
export component SourcesPage inherits VerticalLayout {
    spacing: 16px;
    HorizontalLayout { spacing: 8px;
        Label { text: Theme.t("Источники", "Sources"); font-size: (28px) * Theme.font-scale; font-weight: 650; }
        Action {
            text: State.source-selection ? Theme.t("Отмена", "Cancel") : Theme.t("Выбрать", "Select");
            icon: State.source-selection ? @image-url("../icons/close.svg") : @image-url("../icons/check.svg");
            accessible-label: State.source-selection ? Theme.t("Отменить выбор источников", "Cancel source selection") : Theme.t("Выбрать источники", "Select sources");
            enabled: State.sources.length > 0;
            clicked => { State.action(State.source-selection ? "clear-source-selection" : "select-sources", ""); }
        }
    }
    if !State.compact: Label { text: Theme.t("Список аудиокниг", "Audiobook list"); color: Theme.muted; wrap: word-wrap; }
    if State.source-selection: HorizontalLayout { spacing: 8px;
        Toggle {
            text: Theme.t("Выбрать все", "Select all");
            checked: State.sources.length > 0 && State.selected-source-count == State.sources.length;
            toggled => { State.action(self.checked ? "select-all-sources" : "deselect-sources", ""); }
        }
        Label { text: Theme.t("Выбрано: ", "Selected: ") + State.selected-source-count; color: Theme.muted; horizontal-alignment: right; }
    }
    if State.source-busy: BusyStatus { text: Theme.t("Обновляем источник…", "Updating source…"); }
    Rectangle {
        vertical-stretch: 1;
        ListView {
            width: parent.width; height: parent.height;
            for source[index] in State.sources: VerticalLayout {
                padding-top: State.compact ? 4px : 12px;
                // The final row can scroll clear of the floating action.
                padding-bottom: (State.compact ? 8px : 18px) + (index == State.sources.length - 1 ? Theme.action-height + 24px : 0px);
                spacing: 8px;
                if State.source-selection: Toggle {
                    text: source.path; description: source.detail;
                    accessible-label: Theme.t("Выбрать источник: ", "Select source: ") + source.path;
                    checked: source.selected;
                    background: source.selected ? Theme.tint : transparent;
                    toggled => { State.action("select-source", source.key); }
                }
                if !State.source-selection: Label { text: source.path; font-size: (13px) * Theme.font-scale; wrap: word-wrap; }
                if !State.source-selection: Label { text: source.detail; color: Theme.muted; font-size: (12px) * Theme.font-scale; }
                if !State.source-selection: HorizontalLayout { spacing: 6px; alignment: start;
                    Action { text: Theme.t("Обновить…", "Update…"); icon: @image-url("../icons/refresh.svg"); enabled: !State.source-busy; clicked => { State.action("begin-source-edit", source.key); } }
                    Action { icon: @image-url("../icons/trash.svg"); destructive: true; enabled: !State.source-busy; accessible-label: Theme.t("Удалить источник", "Remove source"); clicked => { State.remove-key = source.key; State.remove-kind = "source"; State.overlay = 1; } }
                }
            }
        }
        Action {
            x: parent.width - self.width - 4px; y: max(0px, parent.height - self.height - 12px);
            width: min(parent.width - 8px, self.preferred-width);
            text: State.source-selection ? Theme.t("Удалить выбранные", "Remove selected") : Theme.t("Добавить папку", "Add a folder");
            icon: State.source-selection ? @image-url("../icons/trash.svg") : @image-url("../icons/plus.svg");
            primary: !State.source-selection; destructive: State.source-selection;
            enabled: !State.source-selection || (State.selected-source-count > 0 && !State.source-busy);
            border-radius: 14px;
            drop-shadow-blur: 8px; drop-shadow-offset-y: 2px; drop-shadow-color: #00000028;
            clicked => {
                if (State.source-selection) { State.action("confirm-remove-sources", ""); }
                else { State.navigate(2); }
            }
        }
    }
}
component ShortcutRow inherits HorizontalLayout {
    in property <string> keys;
    in property <string> description;
    spacing: 14px;
    height: max(38px, caption.preferred-height + 12px);
    Rectangle {
        width: State.compact ? 112px : 136px;
        VerticalLayout { alignment: center;
            Rectangle {
                height: 30px; border-radius: 6px;
                background: Theme.raised; border-width: 1px; border-color: Theme.line;
                Label { text: root.keys; font-family: "monospace"; font-size: (12px) * Theme.font-scale; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
    }
    caption := Label { text: root.description; font-size: (13px) * Theme.font-scale; wrap: word-wrap; vertical-alignment: center; }
}

export component AboutPage inherits ScrollView {
    VerticalLayout {
        spacing: 20px; padding: State.compact ? 4px : 20px; alignment: start;
        HorizontalLayout { alignment: start; Action { text: Theme.t("Назад", "Back"); icon: @image-url("../icons/back.svg"); quiet: true; clicked => { State.navigate(3); } } }
        HorizontalLayout { alignment: center; spacing: 18px;
            Image { source: @image-url("../../data/icons/io.github.mny315.Carlitos.svg"); width: 80px; height: 80px; }
            VerticalLayout { alignment: center; spacing: 6px;
                Label { text: "Carlitos"; font-size: (32px) * Theme.font-scale; font-weight: 650; }
                Label { text: Theme.t("Версия 1.0.3", "Version 1.0.3"); color: Theme.muted; }
            }
        }
        Label { text: Theme.t("Ваши книги. Ваш ритм.", "Your books. Your pace."); font-size: (21px) * Theme.font-scale; font-weight: 600; horizontal-alignment: center; wrap: word-wrap; }
        Label { text: Theme.t("Локальный плеер аудиокниг для Linux, Windows и Android.", "A local audiobook player for Linux, Windows and Android."); color: Theme.muted; font-size: (15px) * Theme.font-scale; wrap: word-wrap; horizontal-alignment: center; }
        Label { text: Theme.t("Автор — mny315", "Created by mny315"); font-weight: 600; horizontal-alignment: center; }
        Label { text: State.android ? "MIT · Rust · Slint" : State.windows ? "MIT · Rust · Windows Media Foundation · Sonic" : "MIT · Rust · GStreamer"; color: Theme.muted; font-size: (13px) * Theme.font-scale; horizontal-alignment: center; }
        HorizontalLayout { alignment: center;
            Label {
                text: Theme.t("Интерфейс — Slint 1.18.1 · slint.dev", "Interface — Slint 1.18.1 · slint.dev");
                color: slint-link.has-hover || slint-focus.has-focus ? Theme.accent : Theme.muted;
                font-size: (13px) * Theme.font-scale; horizontal-stretch: 0; horizontal-alignment: center; wrap: word-wrap;
                accessible-role: button;
                accessible-label: Theme.t("Открыть сайт Slint", "Open the Slint website");
                accessible-action-default => { Platform.open-url("https://slint.dev"); }
                slint-focus := FocusScope {
                    key-pressed(e) => {
                        if (e.text == " " || e.text == Key.Return) { Platform.open-url("https://slint.dev"); return accept; }
                        return reject;
                    }
                }
                slint-link := TouchArea { mouse-cursor: pointer; clicked => { slint-focus.focus(); Platform.open-url("https://slint.dev"); } }
            }
        }
        if !State.android: HorizontalLayout { alignment: center;
            Rectangle {
                max-width: 560px; horizontal-stretch: 1;
                height: shortcuts.preferred-height;
                background: Theme.surface; border-radius: 12px; border-width: 1px; border-color: Theme.line;
                shortcuts := VerticalLayout {
                    padding: State.compact ? 12px : 16px; spacing: 6px;
                    Label { text: Theme.t("Управление", "Keyboard shortcuts"); font-size: (18px) * Theme.font-scale; font-weight: 600; }
                    Rectangle { height: 6px; }
                    ShortcutRow { keys: Theme.t("Пробел", "Space"); description: Theme.t("Воспроизведение / пауза", "Play / pause"); }
                    ShortcutRow { keys: "Alt + ← / →"; description: Theme.t("Назад / вперёд на 10 с", "Back / forward 10 seconds"); }
                    ShortcutRow { keys: "Ctrl + ← / →"; description: Theme.t("Предыдущая / следующая часть", "Previous / next part"); }
                    ShortcutRow { keys: "Ctrl + F"; description: Theme.t("Поиск в библиотеке", "Search library"); }
                    ShortcutRow { keys: "Ctrl + O"; description: Theme.t("Добавить книги", "Add books"); }
                    ShortcutRow { keys: "Ctrl + L"; description: Theme.t("Открыть библиотеку", "Open library"); }
                    ShortcutRow { keys: "Ctrl + Q"; description: Theme.t("Сохранить и выйти", "Save and quit"); }
                }
            }
        }
    }
}
